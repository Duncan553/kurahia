FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-secret

# Dev uses SQLite by default. Set this for Postgres (production).
DATABASE_URL=

# Auth config
FAILED_ATTEMPTS_LOCKOUT=5
LOCKOUT_MINUTES=15

# Business day boundary (24h clock, UTC)
BUSINESS_DAY_START_HOUR=6

# JWT token lifetimes (seconds)
JWT_ACCESS_TOKEN_EXPIRES=1800
JWT_REFRESH_TOKEN_EXPIRES=2592000

# M-Pesa Daraja (socket — plug in when account is ready)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# WhatsApp Business API (socket — plug in when account is ready)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# SMS gateway — Africa's Talking / Twilio (socket — plug in when gateway is ready)
SMS_API_KEY=
SMS_SENDER_ID=
