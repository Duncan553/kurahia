# Kurahia production environment template.
# Copy to `.env.production` on the hotel server and fill in real values.
# .env.production is gitignored — NEVER commit a file with real secrets.
#
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# ── Core Flask ──────────────────────────────────────────────────────────────
FLASK_ENV=production
FLASK_APP=app

# 64-char minimum. Generate fresh — do not reuse dev values.
SECRET_KEY=<generate-with-secrets.token_urlsafe(64)>
JWT_SECRET_KEY=<generate-with-secrets.token_urlsafe(64)>

# ── Database ────────────────────────────────────────────────────────────────
# psycopg3 driver is installed (not psycopg2). Dialect MUST be
# 'postgresql+psycopg' — bare 'postgresql://' assumes psycopg2 which is
# not installed and will cause a startup error.
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/<dbname>

# ── Operational tuning ──────────────────────────────────────────────────────
# How many failed login attempts before lockout (default 5)
FAILED_ATTEMPTS_LOCKOUT=5
# How long the lockout lasts in minutes (default 15)
LOCKOUT_MINUTES=15
# UTC hour that the business day starts — 6 = 06:00 UTC = 09:00 EAT
BUSINESS_DAY_START_HOUR=6

# ─────────────────────────────────────────────────────────────────
# FUTURE INTEGRATIONS — NOT YET IMPLEMENTED IN CODE
# ─────────────────────────────────────────────────────────────────
# The variables below are anticipated based on each provider's
# standard naming convention. The actual socket implementations
# at app/finance/mpesa.py, app/services/notifications/whatsapp.py,
# and app/services/notifications/sms.py are currently stubs that
# return ("UNCONFIGURED", ...).
#
# Do NOT assume setting these variables will activate the integrations.
# When each socket is built out, verify the real variable names in
# the corresponding source file before setting values here.
#
# The system fully supports manual M-Pesa reconciliation and
# notification logging without these integrations.
# ─────────────────────────────────────────────────────────────────

# M-Pesa Daraja (Safaricom)
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=
# MPESA_ENV=sandbox

# WhatsApp Business API (Meta)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# SMS (Africa's Talking)
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER_ID=
